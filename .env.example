# Copy to backend/.env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./cybermnt_monitor.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME_64_HEX_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY

# Comma-separated origins allowed to hit the dashboard API
CORS_ORIGINS=http://localhost:5500
